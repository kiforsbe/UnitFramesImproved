package-as: UnitFramesImproved

externals:
  Libs/LibStub: https://repos.wowace.com/wow/libstub/tags/1.0
  Libs/CallbackHandler-1.0: https://repos.wowace.com/wow/ace3/trunk/CallbackHandler-1.0
  Libs/AceAddon-3.0: https://repos.wowace.com/wow/ace3/trunk/AceAddon-3.0
  Libs/AceConsole-3.0: https://repos.wowace.com/wow/ace3/trunk/AceConsole-3.0
  Libs/AceEvent-3.0: https://repos.wowace.com/wow/ace3/trunk/AceEvent-3.0

# Tracked files that shouldn't end up inside the shipped in-game addon folder. Anything
# already gitignored (.claude/, .vscode/, Libs/ before it's populated above) never reaches
# the packager in the first place, so it doesn't need listing here too.
ignore:
  - build.ps1
  - deploy
  - ARCHITECTURE.md