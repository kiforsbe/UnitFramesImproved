package-as: UnitFramesImproved

# No externals: the addon only uses Blizzard's own APIs (event frames, SlashCmdList, Settings), so
# there's no Libs/ folder to fetch or embed any more.

# Tracked files that shouldn't end up inside the shipped in-game addon folder. Anything
# already gitignored (.claude/, .vscode/) never reaches the packager in the first place, so it
# doesn't need listing here too.
ignore:
  - build.ps1
  - deploy
  - docs
  - tests
  - tools
  - AGENTS.md
  - ARCHITECTURE.md
  - CLAUDE.md
  - DEVELOPMENT.md
